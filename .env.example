# ------------------------------------------------------------------
# MyPOS — environment template. Copy to `.env` and fill in real values.
# NEVER commit the real `.env` file.
# ------------------------------------------------------------------

# --- Database (MySQL) ---
# Use your Hostinger MySQL connection string in deployment.
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE_NAME"

# --- Auth ---
# Generate with: openssl rand -base64 48
AUTH_SECRET=""
AUTH_SESSION_TTL_HOURS="12"
AUTH_COOKIE_NAME="mypos_session"
NODE_ENV="production"

# --- App ---
NEXT_PUBLIC_APP_NAME="MyPOS"
NEXT_PUBLIC_BUSINESS_NAME="MyPOS Supermarket"
NEXT_PUBLIC_BUSINESS_TAGLINE="Point of Sale"
# Shown on the "forgot password" dialog so staff know who to call.
NEXT_PUBLIC_SUPPORT_CONTACT=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CURRENCY="GHS"
NEXT_PUBLIC_CURRENCY_SYMBOL="GH₵"
NEXT_PUBLIC_LOCALE="en-GH"

# --- Payments ---
# Mock payments are enabled for the current deployment. Change to "live" only
# after configuring and testing real gateway credentials.
PAYMENT_DRIVER="mock"

# --- Mobile Money (MTN / Telecel / AirtelTigo aggregator) ---

# --- Ghana POS card terminal (bridge service on the till LAN) ---
POS_TERMINAL_PROVIDER="generic"
POS_TERMINAL_BRIDGE_URL="http://127.0.0.1:9110"
POS_TERMINAL_API_KEY=""
POS_TERMINAL_TIMEOUT_MS="90000"

# --- Paystack (card-not-present / hosted checkout) ---
CARD_PROVIDER="paystack"
CARD_API_BASE_URL=""
CARD_PUBLIC_KEY=""
CARD_SECRET_KEY=""
# Paystack signs webhooks with the secret key by default; set this only if you use a separate webhook secret.
CARD_WEBHOOK_SECRET=""

# --- Seeding (first admin). Change immediately after first login. ---
SEED_ADMIN_EMAIL="YOUR_PRODUCTION_ADMIN_EMAIL"
SEED_ADMIN_PASSWORD="YOUR_STRONG_INITIAL_PASSWORD"

# Optional role-based test accounts. NEVER enable outside development.
SEED_DEMO_USERS="false"
SEED_DEMO_PASSWORD=""