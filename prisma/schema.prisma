// ---------------------------------------------------------------------------
// VidyPOS — Point of Sale for Ghanaian retailers
// MySQL + Prisma schema
// Money is stored as Decimal(12,2) in Ghana Cedi (GHS).
// Quantities are Decimal(12,3) to support weighed goods (kg).
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =========================== ENUMS =========================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SUPERVISOR
  CASHIER
  STOCK_KEEPER
  ACCOUNTANT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  CASUAL
}

enum ProductType {
  UNIT // sold per piece
  WEIGHED // sold per kg / litre
  SERVICE
}

enum StockMovementType {
  PURCHASE_RECEIPT
  SALE
  SALE_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGE
  EXPIRY
  STOCK_COUNT
}

enum SaleStatus {
  DRAFT // held / parked cart
  COMPLETED
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}

enum PaymentMethod {
  CASH
  MOMO
  CARD_TERMINAL // Ghana POS terminal
  CARD // card-not-present / hosted checkout
  BANK_TRANSFER
  STORE_CREDIT
  LOYALTY_POINTS
  VOUCHER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  CANCELLED
  REVERSED
}

enum MomoNetwork {
  MTN
  VODAFONE
  AIRTELTIGO
}

enum ShiftStatus {
  OPEN
  CLOSED
  RECONCILED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum RefundMethod {
  CASH
  MOMO
  CARD_REVERSAL
  STORE_CREDIT
  EXCHANGE
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  VOID_SALE
  REFUND
  PRICE_OVERRIDE
  DISCOUNT_APPLIED
  DRAWER_OPEN
  SHIFT_OPEN
  SHIFT_CLOSE
  STOCK_ADJUSTMENT
  PERMISSION_CHANGE
  EXPORT
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// =========================== ORGANISATION ==================================

model Store {
  id                         String   @id @default(cuid())
  businessId                 String?  @unique @default(cuid())
  name                       String
  businessType               String?  @default("SUPERMARKET")
  businessRegistrationNumber String?  @db.VarChar(80)
  branchCode                 String   @unique
  phone                      String?
  email                      String?
  addressLine                String?
  city                       String?
  region                     String? // Ghana region e.g. Greater Accra
  country                    String?  @default("Ghana")
  ghanaPostGps               String? // digital address e.g. GA-183-4527
  tinNumber                  String? // Ghana Revenue Authority TIN
  vatNumber                  String?
  currency                   String   @default("GHS")
  timezone                   String   @default("Africa/Accra")
  receiptFooter              String?
  logoUrl                    String?
  taxSettings                String?
  isActive                   Boolean  @default(true)
  emailVerifiedAt            DateTime? @default(now())
  activationCodeHash         String?  @db.VarChar(64)
  activationCodeExpiresAt    DateTime?
  activationCodeSentAt       DateTime?
  activationCodeAttempts     Int      @default(0)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  users           User[]
  registers       Register[]
  products        Product[]
  inventoryLevels InventoryLevel[]
  stockMovements  StockMovement[]
  sales           Sale[]
  purchaseOrders  PurchaseOrder[]
  shifts          Shift[]
  customers       Customer[]
  suppliers       Supplier[]
  returns         SaleReturn[]
  settings        Setting[]
  subscriptions   StoreSubscription[]
  taxRates        TaxRate[]
  supportTickets  SupportTicket[]

  @@index([isActive])
}

model Register {
  id           String   @id @default(cuid())
  storeId      String
  name         String // e.g. "Till 1"
  code         String
  terminalId   String? // Ghana card-terminal serial / TID
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shifts Shift[]
  sales  Sale[]

  @@unique([storeId, code])
  @@index([storeId])
}

model StoreSubscription {
  id                   String             @id @default(cuid())
  storeId              String
  plan                 String
  status               SubscriptionStatus @default(TRIALING)
  provider             String?
  providerSubscriptionId String?
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  trialEndsAt          DateTime?
  canceledAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@index([currentPeriodEnd])
}

model PlatformPlan {
  key          String   @id
  monthlyPrice Decimal? @db.Decimal(12, 2)
  updatedAt    DateTime @updatedAt
  updatedById  String?
}

// =========================== IDENTITY & ACCESS =============================

model User {
  id                  String     @id @default(cuid())
  storeId             String?
  staffCode           String     // used for quick till login within a store
  fullName            String
  email               String?    @unique
  phone               String?
  passwordHash        String?
  staffAccessCodeHash String?    @unique
  staffAccessCodeEncrypted String?
  pinHash             String? // 4-6 digit till PIN
  role                UserRole   @default(CASHIER)
  status              UserStatus @default(ACTIVE)
  mustChangePassword  Boolean    @default(true)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  avatarUrl           String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  store           Store?           @relation(fields: [storeId], references: [id], onDelete: SetNull)
  employeeProfile Employee?
  sessions        Session[]
  permissions     UserPermission[]
  shifts          Shift[]
  sales           Sale[]
  stockMovements  StockMovement[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  supportTickets  SupportTicket[]
  supportMessages SupportTicketMessage[]
  supportPresence SupportTicketPresence[]
  purchaseOrders  PurchaseOrder[]
  approvedReturns SaleReturn[]     @relation("ReturnApprover")
  createdReturns  SaleReturn[]     @relation("ReturnCreator")

  @@unique([storeId, staffCode])
  @@index([storeId, role])
  @@index([status])
}

/// Grants a permission beyond (or explicitly denied from) the role baseline.
model UserPermission {
  id        String   @id @default(cuid())
  userId    String
  key       String // e.g. "sales.void", "reports.yearly.view"
  allowed   Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique // SHA-256 of the session token; raw token never stored
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Employee {
  id             String         @id @default(cuid())
  userId         String         @unique
  employeeNumber String
  position       String?
  department     String?
  employmentType EmploymentType @default(FULL_TIME)
  hireDate       DateTime?
  terminationDate DateTime?
  baseSalary     Decimal?       @db.Decimal(12, 2)
  ssnitNumber    String? // Ghana SSNIT
  ghanaCardNumber String?
  emergencyName  String?
  emergencyPhone String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, employeeNumber])
}

// =========================== CATALOGUE =====================================

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  logoUrl   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model UnitOfMeasure {
  id           String    @id @default(cuid())
  name         String    @unique // Kilogram
  abbreviation String    @unique // kg
  isDecimal    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  products     Product[]
}

model Product {
  id             String      @id @default(cuid())
  storeId        String
  sku            String
  name           String
  description    String?
  type           ProductType @default(UNIT)
  categoryId     String?
  brandId        String?
  unitId         String?
  supplierId     String?
  imageUrl       String?

  costPrice      Decimal     @db.Decimal(12, 2)
  sellingPrice   Decimal     @db.Decimal(12, 2)
  taxRateId      String?
  isVatInclusive Boolean     @default(true)

  reorderLevel   Decimal     @default(0) @db.Decimal(12, 3)
  reorderQty     Decimal     @default(0) @db.Decimal(12, 3)
  trackStock     Boolean     @default(true)
  allowDiscount  Boolean     @default(true)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  store           Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand           Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unit            UnitOfMeasure?   @relation(fields: [unitId], references: [id], onDelete: SetNull)
  supplier        Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  taxRate         TaxRate?         @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  barcodes        Barcode[]
  batches         ProductBatch[]
  inventoryLevels InventoryLevel[]
  stockMovements  StockMovement[]
  saleItems       SaleItem[]
  purchaseItems   PurchaseOrderItem[]
  returnItems     SaleReturnItem[]
  priceHistory    PriceHistory[]

  @@unique([storeId, sku])
  @@unique([storeId, name])
  @@index([storeId, isActive])
  @@index([categoryId])
  @@index([name])
}

/// A product may carry several barcodes (manufacturer EAN, inner-carton, PLU).
model Barcode {
  id        String   @id @default(cuid())
  productId String
  code      String
  packSize  Decimal  @default(1) @db.Decimal(12, 3)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@unique([productId, code])
}

model TaxRate {
  id          String    @id @default(cuid())
  storeId     String
  name        String
  rate        Decimal   @db.Decimal(6, 4) // 0.2150 for the combined Ghana rate
  description String?
  isDefault   Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([storeId, name])
  @@index([storeId, isActive])
}

model PriceHistory {
  id           String   @id @default(cuid())
  productId    String
  oldCost      Decimal  @db.Decimal(12, 2)
  newCost      Decimal  @db.Decimal(12, 2)
  oldPrice     Decimal  @db.Decimal(12, 2)
  newPrice     Decimal  @db.Decimal(12, 2)
  changedById  String?
  reason       String?
  createdAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
}

// =========================== INVENTORY =====================================

model InventoryLevel {
  id            String   @id @default(cuid())
  storeId       String
  productId     String
  quantity      Decimal  @default(0) @db.Decimal(12, 3)
  reservedQty   Decimal  @default(0) @db.Decimal(12, 3)
  averageCost   Decimal  @default(0) @db.Decimal(12, 2)
  lastCountedAt DateTime?
  updatedAt     DateTime @updatedAt

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
  @@index([storeId])
}

model ProductBatch {
  id           String    @id @default(cuid())
  productId    String
  batchNumber  String
  expiryDate   DateTime?
  quantity     Decimal   @default(0) @db.Decimal(12, 3)
  costPrice    Decimal   @db.Decimal(12, 2)
  receivedAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@unique([productId, batchNumber])
  @@index([expiryDate])
}

/// Immutable ledger — every quantity change in the system lands here.
model StockMovement {
  id            String            @id @default(cuid())
  storeId       String
  productId     String
  batchId       String?
  type          StockMovementType
  quantity      Decimal           @db.Decimal(12, 3) // signed: negative reduces stock
  balanceAfter  Decimal           @db.Decimal(12, 3)
  unitCost      Decimal?          @db.Decimal(12, 2)
  referenceType String? // "SALE" | "PURCHASE_ORDER" | "RETURN" | "ADJUSTMENT"
  referenceId   String?
  reason        String?
  performedById String?
  createdAt     DateTime          @default(now())

  store       Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch       ProductBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  performedBy User?         @relation(fields: [performedById], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
}

// =========================== PARTNERS ======================================

model Supplier {
  id            String   @id @default(cuid())
  storeId       String
  code          String
  name          String
  contactPerson String?
  phone         String?
  email         String?
  addressLine   String?
  city          String?
  region        String?
  tinNumber     String?
  paymentTerms  String? // "Net 30"
  creditLimit   Decimal? @db.Decimal(12, 2)
  balance       Decimal  @default(0) @db.Decimal(12, 2)
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products       Product[]
  purchaseOrders PurchaseOrder[]

  @@unique([storeId, code])
  @@index([storeId, isActive])
}

model Customer {
  id             String    @id @default(cuid())
  storeId        String
  code           String
  fullName       String
  phone          String?
  email          String?
  addressLine    String?
  city           String?
  dateOfBirth    DateTime?
  loyaltyCardNo  String?
  loyaltyPoints  Int       @default(0)
  storeCredit    Decimal   @default(0) @db.Decimal(12, 2)
  creditLimit    Decimal   @default(0) @db.Decimal(12, 2)
  totalSpent     Decimal   @default(0) @db.Decimal(12, 2)
  visitCount     Int       @default(0)
  lastVisitAt    DateTime?
  notes          String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  store   Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sales   Sale[]
  returns SaleReturn[]

  @@unique([storeId, code])
  @@unique([storeId, loyaltyCardNo])
  @@index([storeId, phone])
  @@index([fullName])
}

// =========================== PURCHASING ====================================

model PurchaseOrder {
  id           String              @id @default(cuid())
  storeId      String
  supplierId   String
  orderNumber  String
  status       PurchaseOrderStatus @default(DRAFT)
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  receivedDate DateTime?
  subtotal     Decimal             @default(0) @db.Decimal(12, 2)
  taxAmount    Decimal             @default(0) @db.Decimal(12, 2)
  discount     Decimal             @default(0) @db.Decimal(12, 2)
  total        Decimal             @default(0) @db.Decimal(12, 2)
  amountPaid   Decimal             @default(0) @db.Decimal(12, 2)
  notes        String?
  createdById  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  store     Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier  Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items     PurchaseOrderItem[]

  @@unique([storeId, orderNumber])
  @@index([storeId, status])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id              String   @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Decimal  @db.Decimal(12, 3)
  receivedQty     Decimal  @default(0) @db.Decimal(12, 3)
  unitCost        Decimal  @db.Decimal(12, 2)
  lineTotal       Decimal  @db.Decimal(12, 2)
  batchNumber     String?
  expiryDate      DateTime?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
}

// =========================== SHIFTS ========================================

model Shift {
  id              String      @id @default(cuid())
  storeId         String
  registerId      String
  cashierId       String
  shiftNumber     String
  status          ShiftStatus @default(OPEN)
  openingFloat    Decimal     @db.Decimal(12, 2)
  closingCount    Decimal?    @db.Decimal(12, 2) // cash physically counted
  expectedCash    Decimal?    @db.Decimal(12, 2)
  cashVariance    Decimal?    @db.Decimal(12, 2)
  totalSales      Decimal     @default(0) @db.Decimal(12, 2)
  totalCash       Decimal     @default(0) @db.Decimal(12, 2)
  totalMomo       Decimal     @default(0) @db.Decimal(12, 2)
  totalCard       Decimal     @default(0) @db.Decimal(12, 2)
  totalRefunds    Decimal     @default(0) @db.Decimal(12, 2)
  transactionCount Int        @default(0)
  openedAt        DateTime    @default(now())
  closedAt        DateTime?
  notes           String?

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  register Register  @relation(fields: [registerId], references: [id], onDelete: Restrict)
  cashier  User      @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  sales    Sale[]
  cashDrops CashDrop[]

  @@unique([storeId, shiftNumber])
  @@index([storeId, status])
  @@index([cashierId, openedAt])
}

model CashDrop {
  id          String   @id @default(cuid())
  shiftId     String
  amount      Decimal  @db.Decimal(12, 2)
  reason      String?
  performedById String?
  createdAt   DateTime @default(now())

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
}

// =========================== SALES =========================================

model Sale {
  id            String     @id @default(cuid())
  storeId       String
  registerId    String?
  shiftId       String?
  cashierId     String
  customerId    String?
  receiptNumber String
  status        SaleStatus @default(DRAFT)

  subtotal       Decimal    @default(0) @db.Decimal(12, 2)
  discountType   DiscountType?
  discountValue  Decimal    @default(0) @db.Decimal(12, 2)
  discountAmount Decimal    @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal    @default(0) @db.Decimal(12, 2)
  total          Decimal    @default(0) @db.Decimal(12, 2)
  amountPaid     Decimal    @default(0) @db.Decimal(12, 2)
  changeDue      Decimal    @default(0) @db.Decimal(12, 2)
  refundedAmount Decimal    @default(0) @db.Decimal(12, 2)

  itemCount      Int        @default(0)
  pointsEarned   Int        @default(0)
  pointsRedeemed Int        @default(0)
  note           String?
  voidReason     String?
  voidedAt       DateTime?
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  store    Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  register Register?    @relation(fields: [registerId], references: [id], onDelete: SetNull)
  shift    Shift?       @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  cashier  User         @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  customer Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    SaleItem[]
  payments Payment[]
  returns  SaleReturn[]
  receipts Receipt[]

  @@unique([storeId, receiptNumber])
  @@index([storeId, createdAt])
  @@index([storeId, status])
  @@index([status, storeId])
  @@index([shiftId])
  @@index([customerId])
  @@index([completedAt])
}

model SaleItem {
  id             String   @id @default(cuid())
  saleId         String
  productId      String
  productName    String // snapshot — product may be renamed later
  sku            String
  barcode        String?
  quantity       Decimal  @db.Decimal(12, 3)
  unitPrice      Decimal  @db.Decimal(12, 2)
  unitCost       Decimal  @default(0) @db.Decimal(12, 2) // snapshot for margin reports
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  taxRate        Decimal  @default(0) @db.Decimal(6, 4)
  taxAmount      Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal  @db.Decimal(12, 2)
  refundedQty    Decimal  @default(0) @db.Decimal(12, 3)
  priceOverridden Boolean @default(false)
  createdAt      DateTime @default(now())

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id             String        @id @default(cuid())
  saleId         String
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  amount         Decimal       @db.Decimal(12, 2)
  tenderedAmount Decimal?      @db.Decimal(12, 2) // cash given by customer
  changeAmount   Decimal?      @db.Decimal(12, 2)

  // Mobile money
  momoNetwork    MomoNetwork?
  momoPhone      String?
  momoReference  String?

  // Card terminal
  terminalId     String?
  cardScheme     String? // VISA / MASTERCARD / GHLINK
  cardLast4      String?
  authCode       String?
  rrn            String? // retrieval reference number

  externalRef    String?   @unique
  failureReason  String?
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([method, status])
  @@index([status, saleId])
  @@index([createdAt])
}

model Receipt {
  id             String   @id @default(cuid())
  saleId         String
  receiptNumber  String
  format         String   @default("THERMAL_80MM") // THERMAL_80MM | A4 | SMS | EMAIL
  payload        Json // rendered receipt snapshot
  printedCount   Int      @default(0)
  sentToPhone    String?
  sentToEmail    String?
  createdAt      DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

// =========================== RETURNS =======================================

model SaleReturn {
  id            String       @id @default(cuid())
  storeId       String
  saleId        String
  customerId    String?
  returnNumber  String
  status        ReturnStatus @default(PENDING)
  refundMethod  RefundMethod @default(CASH)
  subtotal      Decimal      @default(0) @db.Decimal(12, 2)
  taxAmount     Decimal      @default(0) @db.Decimal(12, 2)
  total         Decimal      @default(0) @db.Decimal(12, 2)
  reason        String
  restock       Boolean      @default(true)
  createdById   String?
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  store      Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sale       Sale             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  customer   Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy  User?            @relation("ReturnCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User?            @relation("ReturnApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  items      SaleReturnItem[]

  @@unique([storeId, returnNumber])
  @@index([storeId, createdAt])
  @@index([saleId])
}

model SaleReturnItem {
  id           String  @id @default(cuid())
  returnId     String
  saleItemId   String
  productId    String
  quantity     Decimal @db.Decimal(12, 3)
  unitPrice    Decimal @db.Decimal(12, 2)
  taxAmount    Decimal @default(0) @db.Decimal(12, 2)
  lineTotal    Decimal @db.Decimal(12, 2)
  condition    String? // RESALEABLE | DAMAGED | EXPIRED
  reason       String?

  saleReturn SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([returnId])
}

// =========================== SYSTEM ========================================

model AuditLog {
  id         String      @id @default(cuid())
  storeId    String?
  userId     String?
  action     AuditAction
  entity     String // "Product" | "Sale" | ...
  entityId   String?
  summary    String
  changes    Json? // { field: { from, to } }
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([action])
}

model Setting {
  id        String   @id @default(cuid())
  storeId   String?
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, key])
}

model Notification {
  id        String          @id @default(cuid())
  userId    String?
  storeId   String?
  type      NotificationType @default(INFO)
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime        @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([storeId, createdAt])
}

model SupportTicket {
  id          String                @id @default(cuid())
  storeId     String
  createdById String
  subject     String
  category    String
  priority    SupportTicketPriority @default(NORMAL)
  status      SupportTicketStatus   @default(OPEN)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  resolvedAt  DateTime?

  store     Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy User                  @relation(fields: [createdById], references: [id], onDelete: Cascade)
  messages  SupportTicketMessage[]
  presence  SupportTicketPresence[]

  @@index([storeId, status, updatedAt])
  @@index([status, priority, updatedAt])
}

model SupportTicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())
  readAt    DateTime?

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model SupportTicketPresence {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ticketId, userId])
  @@index([ticketId, expiresAt])
}

/// Per-entity counters used to generate receipt / order / shift numbers safely.
model NumberSequence {
  id        String   @id @default(cuid())
  storeId   String
  scope     String // "RECEIPT" | "PO" | "RETURN" | "SHIFT" | "CUSTOMER" | "SUPPLIER"
  prefix    String
  period    String // "2026-09" or "ALL"
  current   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([storeId, scope, period])
}

model UsageLimit {
  id              String   @id @default(cuid())
  storeId         String
  metric          String   // staff_count, branches, offline_sync_minutes, reports_exports
  currentValue    Int      @default(0)
  maxValue        Int?
  updatedAt       DateTime @updatedAt

  @@unique([storeId, metric])
  @@index([storeId, metric])
}

model OfflineSaleDraft {
  id          String   @id @default(cuid())
  storeId     String
  cashierId   String?
  payload     Json
  syncedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([storeId, createdAt])
}

/// Daily rollup maintained as sales complete, so period reports never scan the
/// whole Sale table. Rebuildable from Sale + Payment at any time.
model DailySalesSummary {
  id               String   @id @default(cuid())
  storeId          String
  date             DateTime @db.Date
  grossSales       Decimal  @default(0) @db.Decimal(14, 2)
  discountTotal    Decimal  @default(0) @db.Decimal(14, 2)
  taxTotal         Decimal  @default(0) @db.Decimal(14, 2)
  refundTotal      Decimal  @default(0) @db.Decimal(14, 2)
  netSales         Decimal  @default(0) @db.Decimal(14, 2)
  costOfGoods      Decimal  @default(0) @db.Decimal(14, 2)
  grossProfit      Decimal  @default(0) @db.Decimal(14, 2)
  cashTotal        Decimal  @default(0) @db.Decimal(14, 2)
  momoTotal        Decimal  @default(0) @db.Decimal(14, 2)
  cardTerminalTotal Decimal @default(0) @db.Decimal(14, 2)
  cardTotal        Decimal  @default(0) @db.Decimal(14, 2)
  otherTotal       Decimal  @default(0) @db.Decimal(14, 2)
  transactionCount Int      @default(0)
  itemCount        Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt        DateTime @updatedAt

  @@unique([storeId, date])
  @@index([storeId, date])
}
